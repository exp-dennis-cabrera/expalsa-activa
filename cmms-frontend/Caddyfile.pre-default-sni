{$PUBLIC_HOSTNAME} {
	tls internal
	# Cabeceras de seguridad (control ISO 27001).
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# La API (incluido el WebSocket de notificaciones, /api/ws) queda en
	# /api/* -- Caddy le saca ese prefijo antes de mandarla al backend,
	# que sigue esperando /auth/login, /ws, /work-orders, etc. Caddy
	# maneja el upgrade de WebSocket automaticamente, sin config aparte.
	handle_path /api/* {
		reverse_proxy backend:8080
	}

	# Archivos guardados en MinIO (fotos de ordenes, adjuntos, avatares).
	#
	# El backend le habla a MinIO por su nombre interno de Docker
	# ("http://minio:9000"), pero el navegador no conoce ese nombre. Sin
	# esta ruta, las imagenes fallaban con ERR_NAME_NOT_RESOLVED y ademas
	# con "Mixed Content" por ser http dentro de una pagina https.
	#
	# Los enlaces vienen FIRMADOS y con vencimiento de 1 hora, asi que
	# exponer esta ruta no deja el bucket abierto: sin firma valida, MinIO
	# rechaza la peticion.
	handle_path /storage/* {
		reverse_proxy minio:9000 {
			# LA LINEA CLAVE: se reescribe el Host al interno.
			#
			# El backend firma los enlaces usando "minio:9000", y la firma
			# de S3 incluye el host en su calculo. Si la peticion le llega
			# a MinIO con el host publico, la firma no coincide y responde
			# "SignatureDoesNotMatch". Reescribiendolo aca, MinIO ve el
			# mismo host con el que se firmo.
			#
			# Equivale al "proxy_set_header Host minio:9000" del nginx.conf
			# de Atlas CMMS.
			header_up Host minio:9000
		}
		# Subidas grandes sin acumularlas en memoria del proxy.
		request_body {
			max_size 500MB
		}
	}

	# Todo lo demas: los archivos estaticos del frontend ya compilado.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	encode gzip
}
