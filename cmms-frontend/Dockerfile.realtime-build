# syntax=docker/dockerfile:1
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
# npm ci en vez de npm install, igual que el Dockerfile de Atlas CMMS.
#
# La diferencia importa: "install" puede resolver versiones distintas en
# cada compilacion segun los rangos del package.json; "ci" instala EXACTO
# lo que dice package-lock.json. Eso hace que el build sea reproducible --
# la imagen de hoy y la de dentro de seis meses llevan lo mismo.
#
# Los reintentos de descarga tambien vienen del Dockerfile real: evitan que
# una conexion lenta tumbe la compilacion.
#
# --legacy-peer-deps es igual que el Dockerfile de Atlas. Hace falta porque
# react-beautiful-dnd 13.1.0 declara soportar solo hasta React 17, y aca
# corre React 18. La libreria funciona igual (Atlas la usa en produccion),
# pero sin esta bandera npm se niega a instalarla.
RUN --mount=type=cache,id=cmms-npm,target=/root/.npm,sharing=locked \
    npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm ci --legacy-peer-deps --prefer-offline --no-audit
COPY . .
# Vite incrusta las variables de entorno en el momento de compilar, no en
# tiempo de ejecucion -- por eso va como build-arg, no como env normal.
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build

# La imagen final solo tiene los archivos ya compilados -- Caddy los sirve
# directo, no hace falta Node corriendo en produccion. El mismo Caddy hace
# de proxy hacia el backend (ver Caddyfile), asi que es el unico servicio
# que queda expuesto al publico.
FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
