import { type ReactNode, useEffect, useMemo, useRef, useState } from 'react';
import {
  Alert,
  Box,
  Chip,
  LinearProgress,
  Paper,
  Stack,
  Typography,
} from '@mui/material';
import ScaleTwoToneIcon from '@mui/icons-material/ScaleTwoTone';
import WifiTwoToneIcon from '@mui/icons-material/WifiTwoTone';
import WifiOffTwoToneIcon from '@mui/icons-material/WifiOffTwoTone';
import AcUnitTwoToneIcon from '@mui/icons-material/AcUnitTwoTone';
import Inventory2TwoToneIcon from '@mui/icons-material/Inventory2TwoTone';

import SockJS from 'sockjs-client';
import { Client, type IMessage } from '@stomp/stompjs';

import {
  CartesianGrid,
  Line,
  LineChart,
  ReferenceLine,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from 'recharts';

import { useAuth } from '../context/AuthContext';
import IceProcessTwin from '../components/ice/IceProcessTwin';

const API_BASE_URL =
  import.meta.env.VITE_API_URL || 'http://localhost:8080';

const TARGET_ASSET =
  'lat-silo-hielo-01-scale-01';

const STALE_AFTER_MS = 12000;

/*
 * Una conexión ya ONLINE que deja de entregar
 * telemetría debe recuperarse rápido.
 */
const TELEMETRY_RECOVERY_AFTER_MS = 20000;

/*
 * El handshake inicial SockJS/STOMP puede necesitar
 * más tiempo. No debemos abortarlo a los mismos
 * 8 segundos usados para detectar telemetría perdida.
 */
const STOMP_CONNECT_TIMEOUT_MS = 15000;

const DESTROY_CLIENT_TIMEOUT_MS = 1500;

/*
 * DEMO únicamente de frontend.
 *
 * No publica MQTT.
 * No llama APIs.
 * No escribe PostgreSQL/Timescale.
 * No genera bag_events reales.
 */
const DEMO_CYCLE_MS = 20000;

const DEMO_FINAL_WEIGHTS = [
  50.12,
  49.84,
  50.26,
  49.95,
];

type RawIceMessage = {
  asset_key?: string;
  assetKey?: string;

  weight_kg?: number;
  weightKg?: number;

  weight_lb?: number;
  weightLb?: number;

  target_weight_lb?: number;
  targetWeightLb?: number;
  targetLb?: number;

  detector_state?: string;
  detectorState?: string;

  quality_code?: number;
  qualityCode?: number;

  ts?: string;
  collected_at?: string;
  collectedAt?: string;
};

type IceLiveData = {
  assetKey: string;
  weightKg: number;
  weightLb: number;
  targetWeightLb: number | null;
  detectorState: string;
  qualityCode: number | null;
  sourceTs: string | null;
  receivedAt: number;
};

type WeightPoint = {
  ts: number;
  weightLb: number;
};

type SessionEventKind =
  | 'info'
  | 'success'
  | 'warning';

type SessionEvent = {
  id: string;
  at: number;
  title: string;
  detail: string;
  kind: SessionEventKind;
};

function firstNumber(
  ...values: Array<number | undefined>
): number | undefined {
  return values.find(
    (value) =>
      typeof value === 'number' &&
      Number.isFinite(value)
  );
}

function normalizeMessage(
  raw: RawIceMessage
): IceLiveData | null {
  const assetKey =
    raw.asset_key ??
    raw.assetKey;

  const weightKg =
    firstNumber(
      raw.weight_kg,
      raw.weightKg
    );

  if (
    !assetKey ||
    weightKg === undefined
  ) {
    return null;
  }

  const receivedWeightLb =
    firstNumber(
      raw.weight_lb,
      raw.weightLb
    );

  const weightLb =
    receivedWeightLb ??
    weightKg * 2.2046226218;

  const targetWeightLb =
    firstNumber(
      raw.target_weight_lb,
      raw.targetWeightLb,
      raw.targetLb
    ) ?? null;

  const detectorState =
    raw.detector_state ??
    raw.detectorState ??
    'UNKNOWN';

  const qualityCode =
    firstNumber(
      raw.quality_code,
      raw.qualityCode
    ) ?? null;

  const sourceTs =
    raw.ts ??
    raw.collected_at ??
    raw.collectedAt ??
    null;

  return {
    assetKey,
    weightKg,
    weightLb,
    targetWeightLb,
    detectorState,
    qualityCode,
    sourceTs,
    receivedAt: Date.now(),
  };
}

function detectorLabel(
  state: string
): string {
  switch (state) {
    case 'WAITING_FOR_LOAD':
      return 'Esperando carga';

    case 'TRACKING_BAG':
      return 'Llenando saco';

    case 'REMOVAL_CONFIRM':
      return 'Confirmando retiro';

    default:
      return state;
  }
}

function qualityLabel(
  code: number | null
): string {
  if (code === 0) {
    return 'Buena';
  }

  if (code === null) {
    return 'Sin información';
  }

  return `Código ${code}`;
}

function parseMessage(
  message: IMessage
): IceLiveData | null {
  try {
    const raw =
      JSON.parse(message.body) as RawIceMessage;

    return normalizeMessage(raw);
  } catch {
    return null;
  }
}

function buildSessionEvent(
  data: IceLiveData,
  at: number
): SessionEvent | null {
  switch (data.detectorState) {
    case 'TRACKING_BAG':
      return {
        id: `${at}-TRACKING_BAG`,
        at,
        title:
          'Inicio de llenado · Balanza #1',
        detail:
          'El detector identificó carga del saco.',
        kind: 'info',
      };

    case 'REMOVAL_CONFIRM':
      return {
        id: `${at}-REMOVAL_CONFIRM`,
        at,
        title:
          'Retiro detectado · Balanza #1',
        detail:
          `Confirmando retiro · ${data.weightLb.toFixed(2)} lb`,
        kind: 'warning',
      };

    case 'WAITING_FOR_LOAD':
      return {
        id: `${at}-WAITING_FOR_LOAD`,
        at,
        title:
          'Balanza #1 en espera',
        detail:
          'Esperando el próximo ciclo de llenado.',
        kind: 'success',
      };

    default:
      return null;
  }
}

function buildDemoSample(
  elapsedMs: number
): IceLiveData {
  const now =
    Date.now();

  const cycleIndex =
    Math.floor(
      elapsedMs /
        DEMO_CYCLE_MS
    );

  const cycleTime =
    elapsedMs %
    DEMO_CYCLE_MS;

  const finalWeight =
    DEMO_FINAL_WEIGHTS[
      cycleIndex %
        DEMO_FINAL_WEIGHTS.length
    ];

  let weightLb = 0.22;
  let detectorState =
    'WAITING_FOR_LOAD';

  /*
   * 0 - 2 s
   * Saco vacío / esperando.
   */
  if (cycleTime < 2000) {
    weightLb =
      0.22 +
      Math.sin(
        cycleTime / 250
      ) * 0.02;

    detectorState =
      'WAITING_FOR_LOAD';
  }

  /*
   * 2 - 13 s
   * Llenado progresivo.
   */
  else if (
    cycleTime < 13000
  ) {
    const rawProgress =
      (cycleTime - 2000) /
      11000;

    /*
     * Curva de llenado:
     * rápida al inicio,
     * más suave cerca de meta.
     */
    const eased =
      1 -
      Math.pow(
        1 - rawProgress,
        1.65
      );

    weightLb =
      0.22 +
      (finalWeight - 0.22) *
        eased +
      Math.sin(
        cycleTime / 330
      ) * 0.05;

    detectorState =
      'TRACKING_BAG';
  }

  /*
   * 13 - 15 s
   * Peso estabilizado próximo
   * al peso final.
   */
  else if (
    cycleTime < 15000
  ) {
    weightLb =
      finalWeight +
      Math.sin(
        cycleTime / 180
      ) * 0.035;

    detectorState =
      'TRACKING_BAG';
  }

  /*
   * 15 - 15.8 s
   * Operador retira el saco.
   * El peso cae rápidamente.
   */
  else if (
    cycleTime < 15800
  ) {
    const drop =
      (cycleTime - 15000) /
      800;

    weightLb =
      finalWeight -
      (
        finalWeight -
        5.0
      ) * drop;

    detectorState =
      'TRACKING_BAG';
  }

  /*
   * 15.8 - 17.2 s
   * FSM confirma retiro.
   */
  else if (
    cycleTime < 17200
  ) {
    weightLb =
      0.22 +
      Math.sin(
        cycleTime / 160
      ) * 0.025;

    detectorState =
      'REMOVAL_CONFIRM';
  }

  /*
   * 17.2 - 20 s
   * Preparado para siguiente saco.
   */
  else {
    weightLb =
      0.22 +
      Math.sin(
        cycleTime / 240
      ) * 0.02;

    detectorState =
      'WAITING_FOR_LOAD';
  }

  weightLb =
    Math.max(
      0,
      weightLb
    );

  return {
    assetKey:
      TARGET_ASSET,

    weightKg:
      weightLb /
      2.2046226218,

    weightLb,

    targetWeightLb:
      50,

    detectorState,

    qualityCode:
      0,

    sourceTs:
      new Date(
        now
      ).toISOString(),

    receivedAt:
      now,
  };
}


function formatClock(
  value: number
): string {
  return new Date(value).toLocaleTimeString(
    'es-EC',
    {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    }
  );
}

export default function IceLivePage() {
  const { role } = useAuth();

  const demoMode =
    useMemo(
      () =>
        new URLSearchParams(
          window.location.search
        ).get('demo') === '1',
      []
    );

  const clientRef =
    useRef<Client | null>(null);

  const [data, setData] =
    useState<IceLiveData | null>(null);

  const [connected, setConnected] =
    useState(false);

  const [connectionError, setConnectionError] =
    useState<string | null>(null);

  const [clock, setClock] =
    useState(Date.now());

  const [weightHistory, setWeightHistory] =
    useState<WeightPoint[]>([]);

  const [sessionEvents, setSessionEvents] =
    useState<SessionEvent[]>([]);

  const previousDetectorStateRef =
    useRef<string | null>(null);

  const authorized =
    role === 'ADMIN' ||
    role === 'LIMITED_ADMIN';

  useEffect(() => {
    const timer =
      window.setInterval(
        () => setClock(Date.now()),
        500
      );

    return () =>
      window.clearInterval(timer);
  }, []);

  useEffect(() => {
    if (
      !authorized ||
      !demoMode
    ) {
      return;
    }

    /*
     * Esta sesión queda completamente
     * separada del STOMP productivo.
     */
    setConnected(true);
    setConnectionError(null);

    setWeightHistory([]);
    setSessionEvents([]);

    previousDetectorStateRef.current =
      null;

    const startedAt =
      Date.now();

    function emitDemoSample() {
      const now =
        Date.now();

      const normalized =
        buildDemoSample(
          now - startedAt
        );

      normalized.receivedAt =
        now;

      setData(
        normalized
      );


      /*
       * MISMO historial visual
       * utilizado por datos reales.
       */
      setWeightHistory(
        (previous) => {
          const cutoff =
            now -
            5 * 60 * 1000;

          const next = [
            ...previous,
            {
              ts: now,
              weightLb:
                normalized.weightLb,
            },
          ].filter(
            (point) =>
              point.ts >=
              cutoff
          );

          return next.slice(
            -750
          );
        }
      );


      /*
       * Mismas transiciones visuales
       * que el detector real.
       */
      if (
        previousDetectorStateRef.current !==
        normalized.detectorState
      ) {
        const event =
          buildSessionEvent(
            normalized,
            now
          );

        previousDetectorStateRef.current =
          normalized.detectorState;

        if (event) {
          setSessionEvents(
            (previous) =>
              [
                event,
                ...previous,
              ].slice(0, 6)
          );
        }
      }
    }


    /*
     * 2 Hz, igual que la telemetría
     * persistida/live que estamos usando.
     */
    emitDemoSample();

    const timer =
      window.setInterval(
        emitDemoSample,
        500
      );


    return () => {
      window.clearInterval(
        timer
      );

      previousDetectorStateRef.current =
        null;
    };
  }, [
    authorized,
    demoMode,
  ]);


  useEffect(() => {
    if (
      !authorized ||
      demoMode
    ) {
      return;
    }

    let disposed = false;

    let currentClient: Client | null = null;

    let reconnectTimer: number | null = null;
    let watchdogTimer: number | null = null;

    let generation = 0;

    let attemptStartedAt = 0;
    let connectedAt = 0;
    let lastMessageAt = 0;

    let recovering = false;


    function clearReconnectTimer() {
      if (reconnectTimer !== null) {
        window.clearTimeout(
          reconnectTimer
        );

        reconnectTimer = null;
      }
    }


    function scheduleReconnect(
      delayMs = 1500
    ) {
      if (
        disposed ||
        recovering ||
        reconnectTimer !== null
      ) {
        return;
      }

      reconnectTimer =
        window.setTimeout(() => {
          reconnectTimer = null;

          if (!disposed) {
            startClient();
          }
        }, delayMs);
    }


    async function destroyClient(
      client: Client | null
    ) {
      if (!client) {
        return;
      }

      client.reconnectDelay = 0;

      try {
        /*
         * Destruimos el CLIENT STOMP completo.
         *
         * No tocamos directamente SockJS/WebSocket.
         */
        await Promise.race([
          client.deactivate({
            force: true,
          }),

          /*
           * @stomp/stompjs puede quedar esperando
           * el cierre de una sesión SockJS antigua.
           *
           * La generación anterior ya fue invalidada,
           * por lo que después de este límite podemos
           * continuar creando un Client completamente nuevo.
           */
          new Promise<void>(
            (resolve) => {
              window.setTimeout(
                resolve,
                DESTROY_CLIENT_TIMEOUT_MS
              );
            }
          ),
        ]);
      } catch {
        // Nunca reutilizamos este Client.
      }
    }


    async function recoverClient() {
      if (
        disposed ||
        recovering
      ) {
        return;
      }

      recovering = true;

      setConnected(false);

      setConnectionError(
        'Recuperando conexión de datos...'
      );

      clearReconnectTimer();

      /*
       * Invalida inmediatamente todos los callbacks
       * pertenecientes a la sesion anterior.
       */
      generation += 1;

      const oldClient =
        currentClient;

      currentClient = null;
      clientRef.current = null;

      attemptStartedAt = 0;
      connectedAt = 0;
      lastMessageAt = 0;

      await destroyClient(
        oldClient
      );

      if (disposed) {
        return;
      }

      /*
       * Dejamos que Spring/SockJS termine de limpiar
       * la sesion anterior antes de crear otra.
       */
      await new Promise<void>(
        (resolve) => {
          window.setTimeout(
            resolve,
            750
          );
        }
      );

      if (disposed) {
        return;
      }

      recovering = false;

      startClient();
    }


    function startClient() {
      if (
        disposed ||
        recovering
      ) {
        return;
      }

      const token =
        localStorage.getItem(
          'cmms_access_token'
        );

      if (!token) {
        setConnected(false);

        setConnectionError(
          'No existe una sesión válida para iniciar el monitoreo.'
        );

        return;
      }

      clearReconnectTimer();

      const myGeneration =
        ++generation;

      attemptStartedAt =
        Date.now();

      connectedAt = 0;
      lastMessageAt = 0;


      const client =
        new Client({

          /*
           * Cada Client crea su propia instancia SockJS.
           */
          webSocketFactory: () =>
            new SockJS(
              `${API_BASE_URL}/ws`
            ) as WebSocket,


          /*
           * IMPORTANTE:
           *
           * deshabilitamos la reconexion automatica
           * interna de @stomp/stompjs.
           *
           * Solo existe un coordinador de reconexion:
           * este componente.
           */
          reconnectDelay: 0,


          connectHeaders: {
            token,
          },


          onConnect: () => {
            if (
              disposed ||
              myGeneration !== generation
            ) {
              return;
            }

            attemptStartedAt = 0;
            connectedAt = Date.now();

            setConnected(true);

            client.subscribe(
              '/ot/ice/live',
              (message) => {

                if (
                  disposed ||
                  myGeneration !== generation
                ) {
                  return;
                }

                const normalized =
                  parseMessage(message);

                if (
                  !normalized ||
                  normalized.assetKey !==
                    TARGET_ASSET
                ) {
                  return;
                }

                lastMessageAt =
                  Date.now();

                setData({
                  ...normalized,
                  receivedAt:
                    lastMessageAt,
                });

                /*
                 * Historial exclusivamente de esta sesión
                 * web. Conservamos cinco minutos.
                 */
                setWeightHistory(
                  (previous) => {
                    const cutoff =
                      lastMessageAt -
                      5 * 60 * 1000;

                    const next = [
                      ...previous,
                      {
                        ts:
                          lastMessageAt,
                        weightLb:
                          normalized.weightLb,
                      },
                    ].filter(
                      (point) =>
                        point.ts >=
                        cutoff
                    );

                    return next.slice(
                      -750
                    );
                  }
                );

                /*
                 * Eventos solo cuando cambia el estado
                 * real del detector.
                 */
                if (
                  previousDetectorStateRef.current !==
                  normalized.detectorState
                ) {
                  const event =
                    buildSessionEvent(
                      normalized,
                      lastMessageAt
                    );

                  previousDetectorStateRef.current =
                    normalized.detectorState;

                  if (event) {
                    setSessionEvents(
                      (previous) =>
                        [
                          event,
                          ...previous,
                        ].slice(0, 6)
                    );
                  }
                }

                /*
                 * Consideramos recuperada la conexion
                 * solo cuando llega telemetria real.
                 */
                setConnectionError(null);
              }
            );
          },


          onDisconnect: () => {
            if (
              disposed ||
              myGeneration !== generation
            ) {
              return;
            }

            setConnected(false);

            scheduleReconnect();
          },


          onWebSocketClose: () => {
            if (
              disposed ||
              myGeneration !== generation
            ) {
              return;
            }

            setConnected(false);

            scheduleReconnect();
          },


          onWebSocketError: () => {
            if (
              disposed ||
              myGeneration !== generation
            ) {
              return;
            }

            setConnected(false);
          },


          onStompError: (frame) => {
            if (
              disposed ||
              myGeneration !== generation
            ) {
              return;
            }

            const stompMessage =
              frame.headers.message ||
              'Error STOMP';

            const normalizedMessage =
              stompMessage.toLowerCase();

            /*
             * Solo detenemos la recuperación automática
             * ante errores reales de autenticación o permisos.
             */
            const authenticationError =
              [
                'access denied',
                'accessdenied',
                'unauthorized',
                'forbidden',
                'authentication',
                'not authenticated',
                'invalid token',
                'expired token',
                'jwt',
              ].some(
                (value) =>
                  normalizedMessage.includes(
                    value
                  )
              );

            setConnected(false);

            if (authenticationError) {
              generation += 1;

              setConnectionError(
                stompMessage
              );

              void destroyClient(
                client
              );

              return;
            }

            /*
             * ERROR STOMP transitorio:
             *
             * utilizamos exclusivamente Watchdog V2
             * para destruir este Client y crear uno nuevo.
             */
            setConnectionError(
              'Recuperando conexión de datos...'
            );

            void recoverClient();
          },
        });


      currentClient = client;
      clientRef.current = client;

      client.activate();
    }


    // --------------------------------------------------------
    // PRIMER CLIENTE
    // --------------------------------------------------------

    startClient();


    // --------------------------------------------------------
    // WATCHDOG
    // --------------------------------------------------------

    watchdogTimer =
      window.setInterval(() => {

        if (
          disposed ||
          recovering ||
          !currentClient
        ) {
          return;
        }

        const now =
          Date.now();


        /*
         * CASO 1:
         *
         * SockJS fue abierto pero STOMP CONNECT
         * no termino dentro del tiempo máximo configurado.
         *
         * No permitimos que quede una sesion
         * esperando ~60-70 segundos en Spring.
         */
        if (!currentClient.connected) {

          if (
            attemptStartedAt > 0 &&
            now - attemptStartedAt >
              STOMP_CONNECT_TIMEOUT_MS
          ) {
            void recoverClient();
          }

          return;
        }


        /*
         * CASO 2:
         *
         * STOMP figura conectado pero dejo
         * de entregar telemetria.
         */
        const referenceTime =
          lastMessageAt ||
          connectedAt;

        if (
          referenceTime > 0 &&
          now - referenceTime >
            TELEMETRY_RECOVERY_AFTER_MS
        ) {
          void recoverClient();
        }

      }, 1000);


    // --------------------------------------------------------
    // CLEANUP DEL COMPONENTE
    // --------------------------------------------------------

    return () => {

      disposed = true;

      generation += 1;

      clearReconnectTimer();

      if (
        watchdogTimer !== null
      ) {
        window.clearInterval(
          watchdogTimer
        );
      }

      const oldClient =
        currentClient;

      currentClient = null;
      clientRef.current = null;

      void destroyClient(
        oldClient
      );
    };

  }, [
    authorized,
    demoMode,
  ]);

  const ageMs =
    data
      ? Math.max(
          0,
          clock - data.receivedAt
        )
      : null;

  const stale =
    ageMs !== null &&
    ageMs > STALE_AFTER_MS;

  const online =
    connected &&
    !!data &&
    !stale;

  const ageLabel = useMemo(() => {
    if (ageMs === null) {
      return 'Sin datos';
    }

    if (ageMs < 1000) {
      return '< 1 s';
    }

    return `${(
      ageMs / 1000
    ).toFixed(1)} s`;
  }, [ageMs]);

  const targetLb =
    data?.targetWeightLb ?? 50;

  const weightLb =
    data?.weightLb ?? null;

  const progress =
    weightLb != null &&
    targetLb > 0
      ? Math.max(
          0,
          Math.min(
            100,
            (weightLb / targetLb) *
              100
          )
        )
      : 0;

  const detectorState =
    data?.detectorState ??
    'UNKNOWN';

  const activeScaleLabel =
    detectorState ===
      'TRACKING_BAG'
      ? 'Llenando'
      : detectorState ===
          'REMOVAL_CONFIRM'
        ? 'Retiro'
        : 'En espera';

  if (!authorized) {
    return (
      <Box sx={{ p: { xs: 2, md: 3 } }}>
        <Typography
          variant="h4"
          fontWeight={700}
          mb={2}
        >
          Monitoreo de hielo
        </Typography>

        <Alert severity="warning">
          Esta pantalla está disponible
          únicamente para administradores.
        </Alert>
      </Box>
    );
  }

  return (
    <Box
      sx={{
        width: '100%',
        maxWidth: 1680,
        mx: 'auto',
        p: {
          xs: 1.5,
          sm: 2,
          md: 2.5,
        },
      }}
    >
      {/* ================================================
          CABECERA
          ================================================ */}

      <Stack
        direction={{
          xs: 'column',
          sm: 'row',
        }}
        justifyContent="space-between"
        alignItems={{
          xs: 'flex-start',
          sm: 'center',
        }}
        spacing={2}
        mb={2}
      >
        <Box>
          <Typography
            sx={{
              fontSize: {
                xs: 23,
                md: 29,
              },
              fontWeight: 800,
              color: '#10224a',
              lineHeight: 1.15,
            }}
          >
            Silo de Hielo · Monitoreo en Vivo
          </Typography>

          <Typography
            color="text.secondary"
            mt={0.4}
          >
            Latamfoods · Silo #1
          </Typography>
        </Box>

        <Stack
          direction="row"
          spacing={1}
          alignItems="center"
        >
          <Chip
            icon={
              online
                ? <WifiTwoToneIcon />
                : <WifiOffTwoToneIcon />
            }
            label={
              online
                ? 'ONLINE'
                : connected
                  ? 'ESPERANDO DATOS'
                  : 'DESCONECTADO'
            }
            color={
              online
                ? 'success'
                : 'default'
            }
            sx={{
              fontWeight: 800,
            }}
          />

          {demoMode && (
            <Chip
              size="small"
              label="MODO DEMO"
              sx={{
                bgcolor:
                  '#fff7ed',
                color:
                  '#c2410c',
                border:
                  '1px solid #fdba74',
                fontWeight: 900,
              }}
            />
          )}

          <Typography
            variant="body2"
            color="text.secondary"
            sx={{
              display: {
                xs: 'none',
                md: 'block',
              },
              fontVariantNumeric:
                'tabular-nums',
            }}
          >
            {new Date(clock).toLocaleTimeString(
              'es-EC',
              {
                hour12: false,
              }
            )}
          </Typography>
        </Stack>
      </Stack>


      {connectionError && (
        <Alert
          severity="warning"
          sx={{ mb: 2 }}
        >
          {connectionError}
        </Alert>
      )}

      {stale &&
        !connectionError && (
          <Alert
            severity="warning"
            sx={{ mb: 2 }}
          >
            La balanza dejó de recibir
            telemetría en tiempo real.
          </Alert>
        )}


      {/* ================================================
          FILA SUPERIOR
          ================================================ */}

      <Box
        sx={{
          display: 'grid',
          gridTemplateColumns: {
            xs: '1fr',
            xl:
              'minmax(0, 1.65fr) minmax(390px, .95fr)',
          },
          gap: 2,
          alignItems: 'stretch',
        }}
      >
        <IceProcessTwin
          weightLb={weightLb}
          targetLb={targetLb}
          detectorState={
            detectorState
          }
          online={online}
          progress={progress}
        />


        {/* ============================================
            KPIs
            ============================================ */}

        <Box
          sx={{
            display: 'grid',
            gridTemplateColumns: {
              xs: '1fr 1fr',
              sm: 'repeat(2, 1fr)',
            },
            gap: 2,
          }}
        >
          <MetricCard
            icon={
              <Inventory2TwoToneIcon />
            }
            label="Sacos hoy"
            value={
              demoMode
                ? '18'
                : '—'
            }
            caption={
              demoMode
                ? 'DEMO · datos simulados'
                : 'Pendiente bag_events'
            }
          />

          <MetricCard
            icon={
              <ScaleTwoToneIcon />
            }
            label="Peso promedio"
            value={
              demoMode
                ? '50.02'
                : '—'
            }
            unit="lb"
            caption={
              demoMode
                ? 'DEMO · últimos 18 sacos'
                : 'Pendiente bag_events'
            }
          />

          <MetricCard
            icon={
              <ScaleTwoToneIcon />
            }
            label="Total acumulado"
            value={
              demoMode
                ? '900.4'
                : '—'
            }
            unit="lb"
            caption={
              demoMode
                ? 'DEMO · peso total'
                : 'Pendiente bag_events'
            }
          />

          <MetricCard
            icon={
              <AcUnitTwoToneIcon />
            }
            label="Meta por saco"
            value={
              targetLb.toFixed(0)
            }
            unit="lb"
            caption="Objetivo configurado"
          />

          <MetricCard
            icon={
              online
                ? <WifiTwoToneIcon />
                : <WifiOffTwoToneIcon />
            }
            label="PLC / MQTT / WebSocket"
            value={
              online
                ? 'OK'
                : stale
                  ? 'STALE'
                  : 'OFF'
            }
            valueColor={
              online
                ? '#16a34a'
                : stale
                  ? '#d97706'
                  : '#64748b'
            }
            caption={
              online
                ? `Último dato ${ageLabel}`
                : 'Conectividad del sistema'
            }
          />

          <MetricCard
            icon={
              <AcUnitTwoToneIcon />
            }
            label="Balanza activa"
            value="#1"
            caption={
              activeScaleLabel
            }
            progress={progress}
          />
        </Box>
      </Box>


      {/* ================================================
          FILA INFERIOR
          ================================================ */}

      <Box
        sx={{
          display: 'grid',
          gridTemplateColumns: {
            xs: '1fr',
            lg:
              'minmax(0, 1.65fr) minmax(360px, .95fr)',
          },
          gap: 2,
          mt: 2,
        }}
      >
        {/* ============================================
            GRAFICA 5 MINUTOS
            ============================================ */}

        <Paper
          variant="outlined"
          sx={{
            p: {
              xs: 1.5,
              md: 2,
            },
            borderRadius: 3,
            borderColor: '#dbe3ef',
            boxShadow:
              '0 8px 28px rgba(15,36,72,.05)',
          }}
        >
          <Stack
            direction="row"
            spacing={1}
            alignItems="center"
            mb={1.5}
          >
            <Box
              sx={{
                color: '#2563eb',
                fontWeight: 800,
                fontSize: 20,
              }}
            >
              ↗
            </Box>

            <Typography
              fontWeight={800}
              color="#10224a"
            >
              Peso últimos 5 minutos
            </Typography>
          </Stack>

          <Box
            sx={{
              width: '100%',
              height: {
                xs: 250,
                md: 285,
              },
            }}
          >
            <ResponsiveContainer
              width="100%"
              height="100%"
            >
              <LineChart
                data={weightHistory}
                margin={{
                  top: 10,
                  right: 14,
                  left: -8,
                  bottom: 0,
                }}
              >
                <CartesianGrid
                  strokeDasharray="3 3"
                  stroke="#e8edf4"
                  vertical={false}
                />

                <XAxis
                  dataKey="ts"
                  type="number"
                  domain={[
                    'dataMin',
                    'dataMax',
                  ]}
                  tickFormatter={(
                    value
                  ) =>
                    new Date(
                      Number(value)
                    ).toLocaleTimeString(
                      'es-EC',
                      {
                        hour:
                          '2-digit',
                        minute:
                          '2-digit',
                        hour12: false,
                      }
                    )
                  }
                  minTickGap={38}
                  tick={{
                    fontSize: 11,
                    fill: '#64748b',
                  }}
                  axisLine={{
                    stroke: '#dbe3ef',
                  }}
                  tickLine={false}
                />

                <YAxis
                  width={42}
                  domain={[
                    0,
                    Math.max(
                      60,
                      Math.ceil(
                        targetLb + 5
                      )
                    ),
                  ]}
                  tick={{
                    fontSize: 11,
                    fill: '#64748b',
                  }}
                  axisLine={false}
                  tickLine={false}
                  label={{
                    value: 'Peso (lb)',
                    angle: -90,
                    position:
                      'insideLeft',
                    offset: 12,
                    fill: '#64748b',
                    fontSize: 11,
                  }}
                />

                <Tooltip
                  labelFormatter={(
                    label
                  ) =>
                    formatClock(
                      Number(label)
                    )
                  }
                  formatter={(
                    value
                  ) => [
                    `${Number(
                      value
                    ).toFixed(2)} lb`,
                    'Peso actual',
                  ]}
                />

                <ReferenceLine
                  y={targetLb}
                  stroke="#16a34a"
                  strokeWidth={2}
                  strokeDasharray="7 6"
                  label={{
                    value:
                      `Meta: ${targetLb.toFixed(
                        0
                      )} lb`,
                    position:
                      'insideTopRight',
                    fill: '#16a34a',
                    fontSize: 12,
                    fontWeight: 700,
                  }}
                />

                <Line
                  type="monotone"
                  dataKey="weightLb"
                  stroke="#1367e8"
                  strokeWidth={3}
                  dot={false}
                  activeDot={{
                    r: 5,
                    fill: '#1367e8',
                    stroke: '#ffffff',
                    strokeWidth: 2,
                  }}
                  isAnimationActive={
                    false
                  }
                />
              </LineChart>
            </ResponsiveContainer>
          </Box>

          {weightHistory.length ===
            0 && (
            <Typography
              variant="caption"
              color="text.secondary"
            >
              La gráfica comenzará a
              llenarse con la telemetría
              recibida en esta sesión.
            </Typography>
          )}
        </Paper>


        {/* ============================================
            EVENTOS
            ============================================ */}

        <Paper
          variant="outlined"
          sx={{
            p: {
              xs: 1.5,
              md: 2,
            },
            borderRadius: 3,
            borderColor: '#dbe3ef',
            boxShadow:
              '0 8px 28px rgba(15,36,72,.05)',
          }}
        >
          <Stack
            direction="row"
            alignItems="center"
            justifyContent="space-between"
            mb={1.5}
          >
            <Typography
              fontWeight={800}
              color="#10224a"
            >
              Eventos recientes
            </Typography>

            <Typography
              variant="caption"
              color="text.secondary"
            >
              Sesión actual
            </Typography>
          </Stack>

          {sessionEvents.length ===
          0 ? (
            <Box
              sx={{
                minHeight: 225,
                display: 'grid',
                placeItems: 'center',
                textAlign: 'center',
              }}
            >
              <Box>
                <AcUnitTwoToneIcon
                  sx={{
                    fontSize: 42,
                    color:
                      'text.disabled',
                  }}
                />

                <Typography
                  color="text.secondary"
                  mt={1}
                >
                  Esperando una transición
                  del detector.
                </Typography>
              </Box>
            </Box>
          ) : (
            <Stack spacing={0}>
              {sessionEvents.map(
                (event) => (
                  <EventRow
                    key={event.id}
                    event={event}
                  />
                )
              )}
            </Stack>
          )}

          <Box
            sx={{
              mt: 1.5,
              pt: 1.5,
              borderTop:
                '1px solid #e8edf4',
            }}
          >
            <Typography
              variant="caption"
              color="text.secondary"
            >
              {demoMode
                ? 'MODO DEMO: estos eventos existen únicamente en memoria del navegador.'
                : 'Los eventos persistentes y conteos diarios se conectarán posteriormente a bag_events.'}
            </Typography>
          </Box>
        </Paper>
      </Box>


      {/* ================================================
          PIE
          ================================================ */}

      <Stack
        direction={{
          xs: 'column',
          sm: 'row',
        }}
        justifyContent="space-between"
        spacing={0.5}
        mt={1.5}
      >
        <Typography
          variant="caption"
          color="text.secondary"
        >
          Activo: {TARGET_ASSET}
        </Typography>

        <Typography
          variant="caption"
          color="text.secondary"
        >
          Calidad:{' '}
          {data
            ? qualityLabel(
                data.qualityCode
              )
            : '—'}
          {' · '}
          Estado:{' '}
          {data
            ? detectorLabel(
                data.detectorState
              )
            : 'Esperando datos'}
        </Typography>
      </Stack>
    </Box>
  );
}


function MetricCard({
  icon,
  label,
  value,
  unit,
  caption,
  progress,
  valueColor,
}: {
  icon: ReactNode;
  label: string;
  value: string;
  unit?: string;
  caption: string;
  progress?: number;
  valueColor?: string;
}) {
  return (
    <Paper
      variant="outlined"
      sx={{
        p: {
          xs: 1.5,
          md: 2,
        },
        minHeight: 144,
        borderRadius: 3,
        borderColor: '#dbe3ef',
        boxShadow:
          '0 7px 22px rgba(15,36,72,.05)',
        display: 'flex',
        flexDirection: 'column',
        justifyContent:
          'space-between',
      }}
    >
      <Stack
        direction="row"
        spacing={1.4}
        alignItems="flex-start"
      >
        <Box
          sx={{
            width: 48,
            height: 48,
            borderRadius: '50%',
            display: 'grid',
            placeItems: 'center',
            bgcolor:
              'rgba(37,99,235,.10)',
            color: '#1367e8',

            '& svg': {
              fontSize: 28,
            },
          }}
        >
          {icon}
        </Box>

        <Box
          sx={{
            minWidth: 0,
            flex: 1,
          }}
        >
          <Typography
            variant="body2"
            color="text.primary"
          >
            {label}
          </Typography>

          <Stack
            direction="row"
            alignItems="baseline"
            spacing={0.5}
          >
            <Typography
              sx={{
                fontSize: {
                  xs: 27,
                  md: 33,
                },
                lineHeight: 1.1,
                fontWeight: 800,
                color:
                  valueColor ??
                  '#1367e8',
                fontVariantNumeric:
                  'tabular-nums',
              }}
            >
              {value}
            </Typography>

            {unit && (
              <Typography
                color="primary.main"
                fontWeight={700}
              >
                {unit}
              </Typography>
            )}
          </Stack>
        </Box>
      </Stack>

      <Box mt={1}>
        <Typography
          variant="caption"
          color="text.secondary"
        >
          {caption}
        </Typography>

        {progress != null && (
          <LinearProgress
            variant="determinate"
            value={progress}
            sx={{
              mt: 0.8,
              height: 7,
              borderRadius: 10,
              bgcolor: '#e7edf5',

              '& .MuiLinearProgress-bar':
                {
                  borderRadius: 10,
                },
            }}
          />
        )}
      </Box>
    </Paper>
  );
}


function EventRow({
  event,
}: {
  event: SessionEvent;
}) {
  const color =
    event.kind === 'success'
      ? '#16a34a'
      : event.kind === 'warning'
        ? '#d97706'
        : '#1367e8';

  return (
    <Stack
      direction="row"
      spacing={1.25}
      sx={{
        py: 1.25,
        borderBottom:
          '1px solid #eef2f7',

        '&:last-of-type': {
          borderBottom: 0,
        },
      }}
    >
      <Box
        sx={{
          width: 25,
          height: 25,
          borderRadius: '50%',
          flexShrink: 0,
          display: 'grid',
          placeItems: 'center',
          bgcolor:
            `${color}16`,
          color,
          fontSize: 12,
          fontWeight: 900,
        }}
      >
        ●
      </Box>

      <Box
        sx={{
          flex: 1,
          minWidth: 0,
        }}
      >
        <Stack
          direction="row"
          justifyContent="space-between"
          spacing={1}
        >
          <Typography
            variant="body2"
            fontWeight={700}
            sx={{
              color: '#10224a',
            }}
          >
            {event.title}
          </Typography>

          <Typography
            variant="caption"
            color="text.secondary"
            sx={{
              flexShrink: 0,
              fontVariantNumeric:
                'tabular-nums',
            }}
          >
            {formatClock(event.at)}
          </Typography>
        </Stack>

        <Typography
          variant="caption"
          color="text.secondary"
        >
          {event.detail}
        </Typography>
      </Box>
    </Stack>
  );
}
