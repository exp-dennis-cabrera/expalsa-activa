import { useState, type FormEvent } from 'react';
import { Link as RouterLink, useNavigate } from 'react-router-dom';
import { Box, Paper, Typography, TextField, Button, Alert, Link } from '@mui/material';
import { useAuth } from '../context/AuthContext';
import { ApiRequestError } from '../api/client';

export default function LoginPage() {
  const { login, verifyMfa } = useAuth();
  const navigate = useNavigate();
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const [loading, setLoading] = useState(false);

  // Segundo paso, solo si el usuario tiene MFA activado.
  const [mfaChallengeToken, setMfaChallengeToken] = useState<string | null>(null);
  const [mfaCode, setMfaCode] = useState('');

  async function handleSubmit(e: FormEvent) {
    e.preventDefault();
    setError(null);
    setLoading(true);
    try {
      const result = await login({ email, password });
      if (result.mfaRequired && result.mfaChallengeToken) {
        setMfaChallengeToken(result.mfaChallengeToken);
      } else {
        navigate('/app/work-orders');
      }
    } catch (err) {
      const message = err instanceof ApiRequestError ? err.message : 'No se pudo iniciar sesión';
      setError(message);
    } finally {
      setLoading(false);
    }
  }

  async function handleVerifyMfa(e: FormEvent) {
    e.preventDefault();
    if (!mfaChallengeToken) return;
    setError(null);
    setLoading(true);
    try {
      await verifyMfa(mfaChallengeToken, mfaCode.trim());
      navigate('/app/work-orders');
    } catch (err) {
      const message = err instanceof ApiRequestError ? err.message : 'Código incorrecto';
      setError(message);
    } finally {
      setLoading(false);
    }
  }

  return (
    <Box
      sx={{
        minHeight: '100vh',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        background: 'linear-gradient(160deg, #0f1b3d 0%, #23306b 55%, #3d4ea8 100%)',
        p: 3,
      }}
    >
      <Paper sx={{ p: 5, width: '100%', maxWidth: 400, borderRadius: 3 }}>
        <Box sx={{ display: 'flex', justifyContent: 'center', mb: 3 }}>
          <Box
            component="img"
            src="/branding/logo-ea-login.png"
            alt="Expalsa Activa"
            sx={{ height: 80, width: 'auto', maxWidth: '100%', objectFit: 'contain' }}
          />
        </Box>

        {!mfaChallengeToken ? (
          <>
            <Box sx={{ mb: 3.5, textAlign: 'center' }}>
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                Iniciar sesión
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary' }}>
                Acceder a Expalsa Activa
              </Typography>
            </Box>

            <Box component="form" onSubmit={handleSubmit} sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
              <TextField
                label="Correo"
                type="email"
                value={email}
                onChange={(e) => setEmail(e.target.value)}
                required
                autoFocus
                fullWidth
              />
              <TextField
                label="Contraseña"
                type="password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
                required
                fullWidth
              />

              {error && <Alert severity="error">{error}</Alert>}

              <Button type="submit" variant="contained" size="large" disabled={loading} fullWidth>
                {loading ? 'Ingresando…' : 'Ingresar'}
              </Button>

              <Link component={RouterLink} to="/forgot-password" variant="body2" sx={{ textAlign: 'center', mt: 1 }}>
                Olvidé mi contraseña
              </Link>
            </Box>

          </>
        ) : (
          <>
            <Box sx={{ mb: 3.5, textAlign: 'center' }}>
              <Typography variant="h6" sx={{ fontWeight: 700 }}>
                Verificación en dos pasos
              </Typography>
              <Typography variant="body2" sx={{ color: 'text.secondary' }}>
                Ingresá el código de tu app de autenticación
              </Typography>
            </Box>

            <Box component="form" onSubmit={handleVerifyMfa} sx={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
              <TextField
                label="Código de 6 dígitos"
                value={mfaCode}
                onChange={(e) => setMfaCode(e.target.value)}
                inputProps={{ inputMode: 'numeric', maxLength: 6 }}
                required
                autoFocus
                fullWidth
              />

              {error && <Alert severity="error">{error}</Alert>}

              <Button type="submit" variant="contained" size="large" disabled={loading} fullWidth>
                {loading ? 'Verificando…' : 'Verificar'}
              </Button>

              <Button
                variant="text"
                onClick={() => {
                  setMfaChallengeToken(null);
                  setMfaCode('');
                  setError(null);
                }}
              >
                Volver
              </Button>
            </Box>
          </>
        )}
      </Paper>
    </Box>
  );
}
